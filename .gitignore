build/
build-*/
sdkconfig
sdkconfig.old
sdkconfig.local
sdkconfig.local.*
managed_components/
__pycache__/
*.pyc
test/host/*/build/
test/host/*/sdkconfig
test/host/*/sdkconfig.old
test/host/*/managed_components/
# The root dependencies.lock is committed: espOS builds as an application
# (main/), and an application pins its registry dependencies exactly through
# its lock, so CI builds the same binary a developer just did. Libraries
# (the components' idf_component.yml) use version ranges instead. The
# host-test projects are throwaway applications; their locks stay out.
test/host/*/dependencies.lock
ui/node_modules/
ui/dist/

# `compote component pack` writes the archive it would upload here.
components/*/dist/
.vscode/
*.log
# Factory-provisioning inputs and images (contain WiFi passwords / tokens)
provisioning/
*.nvs.csv
*.nvs.bin
secrets/
*.secret

# UI dependencies and Vite's intermediate output. The gzipped bundle the
# firmware flashes is COMMITTED, and lives in components/espos_httpd/ui-dist/
# so it ships with the component to registry consumers: `npm run build` in ui/
# regenerates it there, and CI fails when a UI change forgot to commit it.
ui/node_modules/
ui/dist/

# App-signing key (development key is generated on first build; a real one is a secret)
secure_boot_signing_key.pem
*.pem

# Documentation site output and example-project build state (each example is
# its own IDF project; its lock is regenerated, the framework's root lock is tracked)
site/
components/*/examples/*/dependencies.lock
components/*/examples/*/build/
# idf.py drops log/ in the PROJECT root, not build/, when a build fails
# before the build directory is usable -- so a failed example build leaves
# stray idf_py_std*_output files that `git add -A` would otherwise sweep in.
components/*/examples/*/log/
components/*/examples/*/managed_components/
components/*/examples/*/sdkconfig
components/*/examples/*/sdkconfig.old
