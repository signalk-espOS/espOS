{
  "name": "espos-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "espOS device web UI (Preact + Vite), served gzipped from the LittleFS storage partition",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/gzip-dist.mjs",
    "preview": "vite preview",
    "mock": "node mock/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-checker": "^0.14.5"
  }
}
